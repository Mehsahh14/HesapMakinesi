<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="HesapMakinesi.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:HesapMakinesi"
    FlyoutBehavior="Flyout"
    Title="Hesap Makinesi"
    FlyoutBackgroundColor="{AppThemeBinding Light=White, Dark=#171717}">

   
    <Shell.ItemTemplate>
        <DataTemplate>
            <Grid Padding="15,14">
                <Label
                    Text="{Binding Title}"
                    FontSize="16"
                    VerticalOptions="Center"
                    TextColor="{AppThemeBinding Light=#111827, Dark=White}" />
            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>

   
    <FlyoutItem Title="Standart Hesap Makinesi">
        <ShellContent
            Title="Standart"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="main" />
    </FlyoutItem>

  
    <FlyoutItem Title="Bilimsel Hesap Makinesi">
        <ShellContent
            Title="Bilimsel"
            ContentTemplate="{DataTemplate local:ScientificPage}"
            Route="scientific" />
    </FlyoutItem>

    
    <FlyoutItem Title="Ayarlar">
        <ShellContent
            Title="Ayarlar"
            ContentTemplate="{DataTemplate local:SettingsPage}"
            Route="settings" />
    </FlyoutItem>

</Shell>