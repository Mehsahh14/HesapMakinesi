<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="HesapMakinesi.MainPage"
    Title="Standart"
    BackgroundColor="{AppThemeBinding Light={StaticResource LightPageBackground},
                                      Dark={StaticResource DarkPageBackground}}">

    <Grid Padding="12"
          RowDefinitions="Auto,*,Auto"
          RowSpacing="10">

       
        <Border Grid.Row="0"
                Padding="15"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource LightDisplayBackground},
                                                  Dark={StaticResource DarkDisplayBackground}}">

            <Label
                x:Name="DisplayLabel"
                Text="0"
                Style="{StaticResource DisplayLabelStyle}"
                TextColor="{AppThemeBinding Light={StaticResource LightButtonText},
                                            Dark={StaticResource DarkButtonText}}" />

        </Border>

        
        <Grid Grid.Row="1"
              RowDefinitions="*,*,*,*,*"
              ColumnDefinitions="*,*,*,*"
              RowSpacing="5"
              ColumnSpacing="5">

           
            <Button Grid.Row="0" Grid.Column="0"
                    Text="C"
                    Style="{StaticResource OperationButtonStyle}"
                    Clicked="OnClearClicked" />

            <Button Grid.Row="0" Grid.Column="1"
                    Text="÷"
                    Style="{StaticResource OperationButtonStyle}"
                    Clicked="OnOperatorClicked" />

            <Button Grid.Row="0" Grid.Column="2"
                    Text="×"
                    Style="{StaticResource OperationButtonStyle}"
                    Clicked="OnOperatorClicked" />

            <Button Grid.Row="0" Grid.Column="3"
                    Text="−"
                    Style="{StaticResource OperationButtonStyle}"
                    Clicked="OnOperatorClicked" />

           
            <Button Grid.Row="1" Grid.Column="0"
                    Text="7"
                    Style="{StaticResource NumberButtonStyle}"
                    Clicked="OnNumberClicked" />

            <Button Grid.Row="1" Grid.Column="1"
                    Text="8"
                    Style="{StaticResource NumberButtonStyle}"
                    Clicked="OnNumberClicked" />

            <Button Grid.Row="1" Grid.Column="2"
                    Text="9"
                    Style="{StaticResource NumberButtonStyle}"
                    Clicked="OnNumberClicked" />

            <Button Grid.Row="1" Grid.Column="3"
                    Text="+"
                    Style="{StaticResource OperationButtonStyle}"
                    Clicked="OnOperatorClicked" />

           
            <Button Grid.Row="2" Grid.Column="0"
                    Text="4"
                    Style="{StaticResource NumberButtonStyle}"
                    Clicked="OnNumberClicked" />

            <Button Grid.Row="2" Grid.Column="1"
                    Text="5"
                    Style="{StaticResource NumberButtonStyle}"
                    Clicked="OnNumberClicked" />

            <Button Grid.Row="2" Grid.Column="2"
                    Text="6"
                    Style="{StaticResource NumberButtonStyle}"
                    Clicked="OnNumberClicked" />

            <Button Grid.Row="2" Grid.Column="3"
                    Text="="
                    Grid.RowSpan="2"
                    Style="{StaticResource EqualButtonStyle}"
                    Clicked="OnEqualClicked" />

            
            <Button Grid.Row="3" Grid.Column="0"
                    Text="1"
                    Style="{StaticResource NumberButtonStyle}"
                    Clicked="OnNumberClicked" />

            <Button Grid.Row="3" Grid.Column="1"
                    Text="2"
                    Style="{StaticResource NumberButtonStyle}"
                    Clicked="OnNumberClicked" />

            <Button Grid.Row="3" Grid.Column="2"
                    Text="3"
                    Style="{StaticResource NumberButtonStyle}"
                    Clicked="OnNumberClicked" />

           
            <Button Grid.Row="4" Grid.Column="0"
                    Text="±"
                    Style="{StaticResource OperationButtonStyle}"
                    Clicked="OnSignClicked" />

            <Button Grid.Row="4" Grid.Column="1"
                    Text="0"
                    Style="{StaticResource NumberButtonStyle}"
                    Clicked="OnNumberClicked" />

            <Button Grid.Row="4" Grid.Column="2"
                    Text=","
                    Style="{StaticResource NumberButtonStyle}"
                    Clicked="OnDecimalClicked" />

        </Grid>

      
        <Label
            Grid.Row="2"
            Text="Standart Hesap Makinesi"
            Style="{StaticResource DescriptionLabelStyle}"
            TextColor="{AppThemeBinding Light={StaticResource LightSecondaryText},
                                        Dark={StaticResource DarkSecondaryText}}" />

    </Grid>

</ContentPage>
